{
  "manifest_version": 3,
  "name": "EdgeDock — Яндекс Музыка",
  "version": "1.1",
  "description": "Показывает в виджете EdgeDock, что играет в Яндекс Музыке, и передаёт на страницу кнопки плеера, перемотку и лайк из виджета.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.uz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
