<!--
  Дизайн-токены. Все цвета, размеры, радиусы и длительности интерфейса — только здесь.

  Цвета заданы двумя наборами: "Dark.*" и "Light.*". ThemeService копирует набор текущей
  темы Windows в ресурсы "Brush.*" (и "Color.*"), поэтому разметка всегда пишет
  {DynamicResource Brush.Что-то} и сама следует за сменой темы.
  "Brush.Accent" — системный цвет акцента, его тоже выставляет ThemeService.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Отступы: сетка 8 px ===== -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">16</sys:Double>
    <sys:Double x:Key="Space.L">24</sys:Double>
    <Thickness x:Key="Inset.PanelBody">8,0,8,8</Thickness>
    <Thickness x:Key="Inset.Card">8</Thickness>
    <Thickness x:Key="Inset.Row">8,0,4,0</Thickness>
    <Thickness x:Key="Margin.Top.S">0,8,0,0</Thickness>
    <Thickness x:Key="Margin.Top.M">0,16,0,0</Thickness>
    <Thickness x:Key="Margin.Right.S">0,0,8,0</Thickness>
    <Thickness x:Key="Margin.Horizontal.S">8,0,8,0</Thickness>
    <Thickness x:Key="Margin.Overlay">4</Thickness>

    <!-- ===== Радиусы ===== -->
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Strip">2</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">20</CornerRadius>

    <!-- ===== Движение ===== -->
    <Duration x:Key="Motion.Expand">0:0:0.2</Duration>
    <Duration x:Key="Motion.Collapse">0:0:0.15</Duration>
    <Duration x:Key="Motion.Attention">0:0:0.6</Duration>
    <sys:Double x:Key="Motion.SlideDistance">8</sys:Double>

    <!-- ===== Геометрия дока, в независимых от масштаба пикселях ===== -->
    <!-- Полоска у края: видимая черта и чуть более широкая зона, которая реагирует на мышь. -->
    <sys:Double x:Key="Strip.Length">120</sys:Double>
    <sys:Double x:Key="Strip.Thickness">4</sys:Double>
    <sys:Double x:Key="Strip.HitThickness">8</sys:Double>
    <!-- Таблетка в свободном месте. -->
    <sys:Double x:Key="Pill.Width">40</sys:Double>
    <sys:Double x:Key="Pill.Height">120</sys:Double>
    <sys:Double x:Key="Pill.BarLength">40</sys:Double>
    <!-- Панель. Зазор равен Strip.HitThickness, чтобы мышь переходила с полоски на панель без «дырки». -->
    <sys:Double x:Key="Panel.EdgeGap">8</sys:Double>
    <sys:Double x:Key="Panel.HeaderHeight">24</sys:Double>
    <sys:Double x:Key="Panel.GripLength">32</sys:Double>
    <!-- Сдвиг мыши, после которого нажатие становится перетаскиванием. -->
    <sys:Double x:Key="Drag.Threshold">4</sys:Double>
    <sys:Double x:Key="Opacity.SnapHint">0.6</sys:Double>

    <!-- ===== Модули ===== -->
    <!-- Превью снимка: 16:9. При ширине панели 360 видно три превью и край четвёртого. -->
    <sys:Double x:Key="Thumb.Width">96</sys:Double>
    <sys:Double x:Key="Thumb.Height">54</sys:Double>
    <sys:Double x:Key="Shelf.RowHeight">36</sys:Double>
    <sys:Double x:Key="Shelf.MaxHeight">216</sys:Double>
    <sys:Double x:Key="Shelf.IconSize">20</sys:Double>
    <sys:Double x:Key="IconButton.Size">24</sys:Double>
    <sys:Double x:Key="Opacity.Selection">0.2</sys:Double>
    <sys:Double x:Key="Opacity.Missing">0.5</sys:Double>
    <sys:Double x:Key="Opacity.Pressed">0.85</sys:Double>
    <!-- Акцентная заливка при наведении и нажатии (ThemeService делает из них Brush.Accent.Hover/Pressed). -->
    <sys:Double x:Key="Opacity.AccentHover">0.9</sys:Double>
    <sys:Double x:Key="Opacity.AccentPressed">0.8</sys:Double>
    <!-- Музыка и звук. -->
    <sys:Double x:Key="Media.CoverSize">48</sys:Double>
    <sys:Double x:Key="MediaButton.Size">32</sys:Double>
    <sys:Double x:Key="Device.RowHeight">32</sys:Double>
    <sys:Double x:Key="Indicator.Width">3</sys:Double>
    <sys:Double x:Key="Indicator.Height">16</sys:Double>
    <sys:Double x:Key="Chip.Height">24</sys:Double>
    <!-- Микшер: ширина названия программы слева от её полоски громкости. -->
    <sys:Double x:Key="Mixer.NameWidth">96</sys:Double>
    <Thickness x:Key="Inset.Chip">8,0,8,0</Thickness>
    <Thickness x:Key="Margin.Right.XS">0,0,4,0</Thickness>
    <!-- Окно установки. -->
    <sys:Double x:Key="Setup.Width">520</sys:Double>
    <Thickness x:Key="Inset.Setup">24,16,24,24</Thickness>
    <Thickness x:Key="Inset.CardLarge">16</Thickness>
    <Thickness x:Key="Margin.Top.L">0,24,0,0</Thickness>
    <Thickness x:Key="Margin.Left.S">8,0,0,0</Thickness>

    <!-- ===== Шрифты и иконки ===== -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Icon">12</sys:Double>
    <sys:Double x:Key="FontSize.IconLarge">16</sys:Double>
    <sys:String x:Key="Glyph.Tray">&#xE90D;</sys:String>
    <sys:String x:Key="Glyph.Folder">&#xE838;</sys:String>
    <sys:String x:Key="Glyph.Close">&#xE711;</sys:String>
    <sys:String x:Key="Glyph.Previous">&#xE892;</sys:String>
    <sys:String x:Key="Glyph.Next">&#xE893;</sys:String>
    <sys:String x:Key="Glyph.Play">&#xE768;</sys:String>
    <sys:String x:Key="Glyph.Pause">&#xE769;</sys:String>
    <sys:String x:Key="Glyph.Music">&#xE8D6;</sys:String>
    <sys:String x:Key="Glyph.Speaker">&#xE767;</sys:String>
    <sys:String x:Key="Glyph.Microphone">&#xE720;</sys:String>
    <sys:String x:Key="Glyph.Phone">&#xE717;</sys:String>
    <sys:String x:Key="Glyph.Heart">&#xE006;</sys:String>
    <sys:String x:Key="Glyph.HeartFill">&#xE00B;</sys:String>
    <sys:String x:Key="Glyph.Mute">&#xE74F;</sys:String>
    <sys:String x:Key="Glyph.Volume0">&#xE992;</sys:String>
    <sys:String x:Key="Glyph.Volume1">&#xE993;</sys:String>
    <sys:String x:Key="Glyph.Volume2">&#xE994;</sys:String>
    <sys:String x:Key="Glyph.Volume3">&#xE995;</sys:String>

    <!-- ===== Цвета: тёмная тема ===== -->
    <Color x:Key="Dark.Text.Primary">#FFFFFFFF</Color>
    <Color x:Key="Dark.Text.Secondary">#C5FFFFFF</Color>
    <Color x:Key="Dark.Text.Tertiary">#87FFFFFF</Color>
    <!-- Нейтральный серый: едва заметен и на тёмных, и на светлых окнах под полоской. -->
    <Color x:Key="Dark.Handle.Rest">#99A0A0A0</Color>
    <Color x:Key="Dark.Handle.Hover">#E6C8C8C8</Color>
    <Color x:Key="Dark.Handle.Pressed">#CCB0B0B0</Color>
    <Color x:Key="Dark.Pill.Rest">#CC2B2B2B</Color>
    <Color x:Key="Dark.Pill.Hover">#E62B2B2B</Color>
    <Color x:Key="Dark.Pill.Pressed">#D9262626</Color>
    <Color x:Key="Dark.Pill.Border">#26FFFFFF</Color>
    <!-- Только если системный фон недоступен. -->
    <Color x:Key="Dark.Panel.Fallback">#F2202020</Color>
    <!-- Обводка панели, её рисует DWM (цвет должен быть непрозрачным). -->
    <Color x:Key="Dark.Panel.Border">#FF404040</Color>
    <Color x:Key="Dark.Card.Background">#0DFFFFFF</Color>
    <Color x:Key="Dark.Card.Border">#19000000</Color>
    <Color x:Key="Dark.Subtle.Hover">#0FFFFFFF</Color>
    <Color x:Key="Dark.Subtle.Pressed">#0AFFFFFF</Color>
    <Color x:Key="Dark.Thumb.Placeholder">#14FFFFFF</Color>
    <Color x:Key="Dark.Thumb.Border">#14FFFFFF</Color>
    <Color x:Key="Dark.Thumb.BorderHover">#5CFFFFFF</Color>
    <!-- Кнопка поверх превью. -->
    <Color x:Key="Dark.Overlay.Rest">#B31C1C1C</Color>
    <Color x:Key="Dark.Overlay.Hover">#E62C2C2C</Color>
    <!-- Обычная кнопка с текстом (например, «Созвон»). -->
    <Color x:Key="Dark.Button.Rest">#0FFFFFFF</Color>
    <Color x:Key="Dark.Button.Hover">#15FFFFFF</Color>
    <Color x:Key="Dark.Button.Pressed">#08FFFFFF</Color>
    <Color x:Key="Dark.Button.Border">#12FFFFFF</Color>
    <!-- Текст на акцентной заливке. -->
    <Color x:Key="Dark.Text.OnAccent">#FF000000</Color>
    <!-- Ошибка (окно установки). -->
    <Color x:Key="Dark.Text.Critical">#FFFF99A4</Color>
    <!-- Фон окна установки, если Mica недоступна. -->
    <Color x:Key="Dark.Window.Fallback">#FF202020</Color>

    <!-- ===== Цвета: светлая тема ===== -->
    <Color x:Key="Light.Text.Primary">#E4000000</Color>
    <Color x:Key="Light.Text.Secondary">#9E000000</Color>
    <Color x:Key="Light.Text.Tertiary">#72000000</Color>
    <Color x:Key="Light.Handle.Rest">#99707070</Color>
    <Color x:Key="Light.Handle.Hover">#E6505050</Color>
    <Color x:Key="Light.Handle.Pressed">#CC606060</Color>
    <Color x:Key="Light.Pill.Rest">#CCF9F9F9</Color>
    <Color x:Key="Light.Pill.Hover">#E6F9F9F9</Color>
    <Color x:Key="Light.Pill.Pressed">#D9F0F0F0</Color>
    <Color x:Key="Light.Pill.Border">#1A000000</Color>
    <Color x:Key="Light.Panel.Fallback">#F2F3F3F3</Color>
    <Color x:Key="Light.Panel.Border">#FFD5D5D5</Color>
    <Color x:Key="Light.Card.Background">#B3FFFFFF</Color>
    <Color x:Key="Light.Card.Border">#0F000000</Color>
    <Color x:Key="Light.Subtle.Hover">#09000000</Color>
    <Color x:Key="Light.Subtle.Pressed">#06000000</Color>
    <Color x:Key="Light.Thumb.Placeholder">#0F000000</Color>
    <Color x:Key="Light.Thumb.Border">#14000000</Color>
    <Color x:Key="Light.Thumb.BorderHover">#5C000000</Color>
    <Color x:Key="Light.Overlay.Rest">#CCF9F9F9</Color>
    <Color x:Key="Light.Overlay.Hover">#F2FFFFFF</Color>
    <Color x:Key="Light.Button.Rest">#B3FFFFFF</Color>
    <Color x:Key="Light.Button.Hover">#80F9F9F9</Color>
    <Color x:Key="Light.Button.Pressed">#4DF9F9F9</Color>
    <Color x:Key="Light.Button.Border">#0F000000</Color>
    <Color x:Key="Light.Text.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Light.Text.Critical">#FFC42B1C</Color>
    <Color x:Key="Light.Window.Fallback">#FFF3F3F3</Color>

    <!-- ===== Цвета иконки в трее (следуют теме панели задач, а не теме приложений) ===== -->
    <Color x:Key="Tray.Glyph.OnDark">#FFFFFFFF</Color>
    <Color x:Key="Tray.Glyph.OnLight">#FF1C1C1C</Color>

    <!-- Только если Windows не сообщила цвет акцента. -->
    <Color x:Key="Accent.Fallback">#FF0078D4</Color>

</ResourceDictionary>
