<Application x:Class="EdgeDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Элементы управления WPF UI. Тему (светлая/тёмная) и акцент переключает ThemeService. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Общие стили. Все значения — из Tokens.xaml.
              Ничто в окнах дока не принимает клавиатурный фокус: клик по такому элементу активировал бы окно.
            -->

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Card.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
                <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
            </Style>

            <!-- Маленькая кнопка-значок: «В папке», «Убрать». -->
            <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Width" Value="{StaticResource IconButton.Size}" />
                <Setter Property="Height" Value="{StaticResource IconButton.Size}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
                <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource Brush.Subtle.Hover}" />
                <Setter Property="PressedBackground" Value="{DynamicResource Brush.Subtle.Pressed}" />
                <Setter Property="PressedForeground" Value="{DynamicResource Brush.Text.Tertiary}" />
            </Style>

            <!-- Та же кнопка поверх картинки: с подложкой, чтобы значок читался на любом снимке. -->
            <Style x:Key="OverlayIconButton" TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay.Rest}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource Brush.Overlay.Hover}" />
                <Setter Property="PressedBackground" Value="{DynamicResource Brush.Overlay.Rest}" />
            </Style>

            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
