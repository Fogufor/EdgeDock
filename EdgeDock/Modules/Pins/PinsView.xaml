<!--
  Закреплённое: плашки «значок + название», клик копирует то, что скрыто под названием.
  «+» — добавить, правый клик по плашке — изменить или удалить (в отдельном окне: панель фокус не забирает).
-->
<UserControl x:Class="EdgeDock.Modules.Pins.PinsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:EdgeDock.Modules.Pins"
             Focusable="False">

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <!-- Заголовок: высота задана кнопкой «+», поэтому «Скопировано» ничего не сдвигает. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Закреплённое" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="{StaticResource Margin.Right.S}"
                           AutomationProperties.AutomationId="PinsStatus" />
                <ui:Button Grid.Column="2" Content="{StaticResource Glyph.Add}" ToolTip="Добавить ссылку или тег"
                           Click="OnAdd" AutomationProperties.AutomationId="PinsAddButton">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>

            <TextBlock Text="Нажмите +, чтобы добавить ссылку или тег" Foreground="{DynamicResource Brush.Text.Tertiary}"
                       Margin="{StaticResource Margin.Top.S}" TextWrapping="Wrap" AutomationProperties.AutomationId="PinsEmpty">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Items.Count}" Value="0" />
                                    <Condition Binding="{Binding IsBroken}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Не удалось прочитать pins.json" Foreground="{DynamicResource Brush.Text.Critical}"
                       Margin="{StaticResource Margin.Top.S}" TextWrapping="Wrap" AutomationProperties.AutomationId="PinsBroken">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="{StaticResource Margin.ChipList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PinItem}">
                        <ui:Button Style="{StaticResource ChipButton}" Margin="{StaticResource Margin.Chip}"
                                   ToolTip="{Binding Value}" Click="OnPinClick" MouseRightButtonUp="OnPinRightClick"
                                   AutomationProperties.AutomationId="PinChip" AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Значки шрифта одной ширины: галочка вместо значка не меняет ширину плашки. -->
                                <TextBlock x:Name="Glyph" Text="{StaticResource Glyph.Text}" FontFamily="{StaticResource Font.Icons}"
                                           FontSize="{StaticResource FontSize.Icon}" Margin="{StaticResource Margin.Right.XS}"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="PinGlyph" />
                                <TextBlock Text="{Binding Label}" MaxWidth="{StaticResource Pin.LabelMaxWidth}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Link">
                                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Glyph.Link}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Tag">
                                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Glyph.Tag}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Phone">
                                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Glyph.Phone}" />
                            </DataTrigger>
                            <!-- Последним: перекрывает значок вида. -->
                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Glyph.Check}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
