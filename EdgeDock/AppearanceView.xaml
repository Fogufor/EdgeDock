<!--
  Выбор оформления: открывается кнопкой в правом верхнем углу панели вместо блока вкладки.
  Три карточки с маленьким макетом панели, у выбранной — рамка цвета акцента. Смена — сразу, на лету.
-->
<UserControl x:Class="EdgeDock.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False"
             AutomationProperties.AutomationId="View.appearance">

    <UserControl.Resources>
        <!-- Карточка оформления: макет (содержимое) в рамке и подпись (Tag) под ним. -->
        <Style x:Key="LookOption" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="GroupName" Value="Look" />
            <Setter Property="Margin" Value="{StaticResource Margin.Right.S}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <Border x:Name="Frame" CornerRadius="{StaticResource Radius.Card}" Padding="{StaticResource Inset.LookFrame}"
                                    BorderThickness="{StaticResource Border.LookFrame}" BorderBrush="{DynamicResource Brush.Thumb.Border}">
                                <Grid Height="{StaticResource LookPreview.Height}">
                                    <Border CornerRadius="{StaticResource Radius.Small}" Background="{StaticResource Preview.Wallpaper}" />
                                    <Ellipse Width="{StaticResource LookPreview.SunSize}" Height="{StaticResource LookPreview.SunSize}"
                                             Margin="{StaticResource Margin.LookPreviewSun}" Fill="{StaticResource Preview.Sun}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <ContentPresenter Margin="{StaticResource Margin.LookPreviewPanel}" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" Style="{StaticResource Caption}"
                                       Margin="{StaticResource Margin.Top.XS}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Thumb.BorderHover}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="{StaticResource Opacity.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Макет панели внутри карточки: «окно» с двумя строчками «текста». -->
        <Style x:Key="PreviewPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PreviewLine" TargetType="Border">
            <Setter Property="Height" Value="{StaticResource LookPreview.LineHeight}" />
            <Setter Property="Width" Value="{StaticResource LookPreview.LineLong}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.PreviewLine}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="PreviewLineShort" TargetType="Border" BasedOn="{StaticResource PreviewLine}">
            <Setter Property="Width" Value="{StaticResource LookPreview.LineShort}" />
            <Setter Property="Margin" Value="{StaticResource Margin.Top.XS}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="Оформление" Style="{StaticResource Caption}" />

            <UniformGrid Columns="3" Margin="{StaticResource Margin.LookList}">
                <RadioButton x:Name="StandardOption" Style="{StaticResource LookOption}" Tag="Стандартное" Checked="OnLookChecked"
                             AutomationProperties.Name="Стандартное" AutomationProperties.AutomationId="Look.standard">
                    <Border Style="{StaticResource PreviewPanel}" Background="{StaticResource Preview.Standard.Panel}"
                            BorderBrush="{StaticResource Preview.Standard.Border}">
                        <StackPanel VerticalAlignment="Center" Margin="{StaticResource Inset.LookPreviewLines}">
                            <Border Style="{StaticResource PreviewLine}" Background="{StaticResource Preview.Standard.Line}" />
                            <Border Style="{StaticResource PreviewLineShort}" Background="{StaticResource Preview.Standard.Line}" />
                        </StackPanel>
                    </Border>
                </RadioButton>
                <RadioButton x:Name="DarkOption" Style="{StaticResource LookOption}" Tag="Тёмное" Checked="OnLookChecked"
                             AutomationProperties.Name="Тёмное" AutomationProperties.AutomationId="Look.dark">
                    <Border Style="{StaticResource PreviewPanel}" Background="{StaticResource Preview.Dark.Panel}"
                            BorderBrush="{StaticResource Preview.Dark.Border}">
                        <StackPanel VerticalAlignment="Center" Margin="{StaticResource Inset.LookPreviewLines}">
                            <Border Style="{StaticResource PreviewLine}" Background="{StaticResource Preview.Dark.Line}" />
                            <Border Style="{StaticResource PreviewLineShort}" Background="{StaticResource Preview.Dark.Line}" />
                        </StackPanel>
                    </Border>
                </RadioButton>
                <RadioButton x:Name="GlassOption" Style="{StaticResource LookOption}" Tag="Стекло" Checked="OnLookChecked"
                             AutomationProperties.Name="Стекло" AutomationProperties.AutomationId="Look.glass">
                    <Border Style="{StaticResource PreviewPanel}" Background="{StaticResource Preview.Glass.Panel}"
                            BorderBrush="{StaticResource Preview.Glass.Border}">
                        <StackPanel VerticalAlignment="Center" Margin="{StaticResource Inset.LookPreviewLines}">
                            <Border Style="{StaticResource PreviewLine}" Background="{StaticResource Preview.Glass.Line}" />
                            <Border Style="{StaticResource PreviewLineShort}" Background="{StaticResource Preview.Glass.Line}" />
                        </StackPanel>
                    </Border>
                </RadioButton>
            </UniformGrid>

            <TextBlock x:Name="Description" Style="{StaticResource Caption}" Margin="{StaticResource Margin.Top.S}"
                       TextWrapping="Wrap" AutomationProperties.AutomationId="LookDescription" />

            <!-- Цвет акцента виджет берёт из Windows: отсюда — сразу в нужный раздел параметров. -->
            <Grid Margin="{StaticResource Margin.Top.S}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Цвет акцента — как в Windows" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Style="{StaticResource ChipButton}" Content="Изменить"
                           ToolTip="Открыть параметры цвета Windows" Click="OnAccentClick"
                           AutomationProperties.AutomationId="AccentSettingsButton" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
