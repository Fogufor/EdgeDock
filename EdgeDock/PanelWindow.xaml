<!--
  Развёрнутая панель. Фон — системный акрил DWM (его включает код), сама разметка прозрачная.
  Содержимое (Body) проявляется и выезжает через Opacity и RenderTransform.
-->
<Window x:Class="EdgeDock.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        AllowDrop="True"
        Background="Transparent"
        SizeToContent="Manual"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display">

    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="Body" Opacity="0" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Ручка-заголовок: за неё панель перетаскивается. -->
            <Border x:Name="Header" Height="{StaticResource Panel.HeaderHeight}" Background="Transparent">
                <Border x:Name="HeaderGrip"
                        Width="{StaticResource Panel.GripLength}" Height="{StaticResource Strip.Thickness}"
                        CornerRadius="{StaticResource Radius.Strip}"
                        Background="{DynamicResource Brush.Handle.Rest}" />
            </Border>

            <StackPanel x:Name="ModuleHost" Grid.Row="1" Margin="{StaticResource Inset.PanelBody}" />

            <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="{StaticResource Inset.PanelBody}"
                       Text="Модулей пока нет"
                       FontSize="{StaticResource FontSize.Caption}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
