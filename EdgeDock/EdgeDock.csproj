<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EdgeDock</RootNamespace>
    <AssemblyName>EdgeDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версию для релиза подставляет сборка на GitHub (из тега v1.2.3). -->
    <Version>1.5.0</Version>

    <!-- Виджет работает весь день: без фонового потока сборщика мусора и без папок локализации. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Раздаваемая сборка — один EdgeDock.exe со всем .NET внутри (dotnet publish -r win-x64).
    Без сжатия: сжатые библиотеки распаковывались бы в память при каждом запуске.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Расширение для Яндекс Браузера лежит внутри exe: установщик раскладывает его рядом с виджетом. -->
    <EmbeddedResource Include="..\BrowserExtension\*.*" LogicalName="BrowserExtension/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
